# Copy to deploy/.env on the server and fill in. Never commit the real file.

# "staging" for a demo server with test stand-ins and on-screen one-time codes.
# "production" for the live pilot (needs the developer's Fayda, vetting and escrow modules).
APP_ENV=staging

# The address people type, e.g. tod.eruditeafrica.com (gets HTTPS automatically).
# Leave as :80 to serve plain HTTP on the server's IP address.
SITE_ADDRESS=:80
# Full URL of the site, used for the API's allowed origin, e.g. https://tod.eruditeafrica.com
WEB_ORIGIN=http://localhost

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# "console" logs SMS in the API log; "afromessage" sends real SMS.
SMS_PROVIDER=console
AFROMESSAGE_TOKEN=
AFROMESSAGE_SENDER=
