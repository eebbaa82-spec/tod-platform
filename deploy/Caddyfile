# Caddy terminates TLS (a free certificate is fetched automatically when
# SITE_ADDRESS is a domain name pointing at this server) and routes
# <BASE_PATH>/api to the API and everything else to the web app.
# BASE_PATH is empty for a site at the root of its domain, or e.g. /tod.
{$SITE_ADDRESS::80} {
	encode gzip
	request_body {
		max_size 25MB
	}
	# With a sub-path, send visitors of the bare address to the app.
	# (When BASE_PATH is empty this matcher never matches.)
	@bare {
		path /
		not path {$BASE_PATH}/
	}
	redir @bare {$BASE_PATH}/ 302
	handle {$BASE_PATH}/api/* {
		# Drop the sub-path (a no-op when BASE_PATH is empty).
		uri path_regexp ^{$BASE_PATH}/api/ /api/
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
